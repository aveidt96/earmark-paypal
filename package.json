{
  "name": "earmark-paypal",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "contracts",
    "agent",
    "web"
  ],
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "npm run build --workspace @flint/agent && npm run dev --workspace @flint/web",
    "start": "npm run start --workspace @flint/web",
    "paypal:db:plan": "node --import tsx scripts/paypal-migrate.ts",
    "paypal:db:inspect": "node --import tsx scripts/paypal-db-inspect.ts",
    "paypal:db:verify": "node --import tsx scripts/paypal-db-verify.ts",
    "paypal:test:db": "node --import tsx scripts/paypal-db-test.ts",
    "paypal:test:db:all": "node --import tsx scripts/paypal-db-test.ts --all",
    "paypal:test:oauth": "node --conditions=react-server --import tsx scripts/paypal-oauth-test.ts",
    "paypal:test:oauth:all": "node --conditions=react-server --import tsx scripts/paypal-oauth-test.ts --all",
    "paypal:secrets:check": "node --import tsx scripts/paypal-secret-check.ts",
    "paypal:test:serve": "node --conditions=react-server --import tsx scripts/paypal-test-serve.ts",
    "paypal:test:create": "node --import tsx scripts/paypal-test-create.ts",
    "paypal:test:ui": "node scripts/paypal-test-ui.mjs",
    "paypal:test:status": "node --conditions=react-server --import tsx scripts/paypal-test-status.ts",
    "paypal:us:preflight": "node --conditions=react-server --import tsx scripts/paypal-us-preflight.ts",
    "paypal:us:serve": "node --conditions=react-server --import tsx scripts/paypal-test-serve.ts --us-prepare",
    "paypal:us:prepare": "node --conditions=react-server --import tsx scripts/paypal-us-prepare.ts",
    "paypal:us:status": "node --conditions=react-server --import tsx scripts/paypal-test-status.ts --us",
    "paypal:us:order:check": "node --conditions=react-server --import tsx scripts/paypal-us-order.ts",
    "paypal:us:order:create": "node --conditions=react-server --import tsx scripts/paypal-us-order.ts --create",
    "paypal:us:order:verify": "node --conditions=react-server --import tsx scripts/paypal-us-order.ts --verify",
    "paypal:us:capture:check": "node --conditions=react-server --import tsx scripts/paypal-us-capture.ts",
    "paypal:us:capture:execute": "node --conditions=react-server --import tsx scripts/paypal-us-capture.ts --execute",
    "paypal:us:capture:verify": "node --conditions=react-server --import tsx scripts/paypal-us-capture.ts --verify",
    "paypal:recover": "node --conditions=react-server --import tsx scripts/paypal-recover.ts",
    "paypal:test": "npm run test --workspace @flint/web -- paypal-",
    "build": "npm run build --workspaces --if-present",
    "lint": "biome lint . --error-on-warnings && npm run lint --workspace @flint/contracts",
    "typecheck": "npm run build --workspace @flint/agent && npm run typecheck --workspaces --if-present && tsc --project api/src/tsconfig.json --noEmit",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write . && npm run format --workspace @flint/contracts",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "contracts:build": "npm run build --workspace @flint/contracts",
    "contracts:test": "npm run test --workspace @flint/contracts",
    "setup:contracts": "node scripts/setup-foundry.mjs",
    "agent:demo": "npm run contracts:build && npm run build --workspace @flint/agent && node scripts/agent-demo.mjs",
    "agent:test:integration": "npm run contracts:build && npm run test:integration --workspace @flint/agent",
    "web:local": "npm run contracts:build && npm run build --workspace @flint/agent && node scripts/start-workspace.mjs",
    "web:test:e2e": "npm run contracts:build && npm run build --workspace @flint/agent && npm run build --workspace @flint/web && playwright test",
    "demo:scenarios": "npm run contracts:build && npm run build --workspace @flint/agent && node scripts/run-security-demos.mjs",
    "demo:record": "npm run contracts:build && npm run build --workspace @flint/agent && npm run build --workspace @flint/web && node scripts/record-demo.mjs",
    "demo:serve": "npm run contracts:build && npm run build --workspace @flint/agent && npm run build --workspace @flint/web && node scripts/record-demo.mjs --serve",
    "demo:test:browser": "node scripts/record-demo.mjs --verify-only",
    "demo:setup-media": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-demo-media.ps1",
    "api:start": "node --import tsx api/src/main.ts",
    "api:build": "npm run build --workspace @flint/agent && tsc --project api/src/tsconfig.json --noEmit",
    "db:test": "node --env-file-if-exists=.tools/stage-8a/validation.env node_modules/vitest/vitest.mjs run web/test/postgres.integration.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-database.ts",
    "deploy:testnet:owner": "npm run contracts:build && node scripts/deploy-testnet.mjs",
    "deploy:testnet:test": "npm run contracts:build && node --test scripts/deployment-recovery.test.mjs",
    "testnet:fund": "node scripts/fund-testnet-owner.mjs",
    "testnet:fund:test": "node --test scripts/testnet-funding.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@neon/config": "1.8.6",
    "@neon/env": "1.5.3"
  }
}
