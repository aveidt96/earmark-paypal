# LEGACY MONAD REFERENCE ONLY — not Earmark PayPal configuration.
# Do not apply this template to the new PayPal application or database.
# Server-only Render Free configuration for the dedicated Earmark testnet.
# Existing Neon project square-glade-65269089 / branch production.
# Keep the existing pooled DATABASE_URL; supply the direct URL separately.
EARMARK_DATABASE_ENVIRONMENT=earmark-testnet
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AGENT_CHAIN_ID=10143
AGENT_ENABLE_TESTNET=true
AGENT_RPC_URL=https://testnet-rpc.monad.xyz
TASK_VAULT_ADDRESS=0x37c026c7207de8f202a06726eb02e6233ed06160
AGENT_EXPECTED_VAULT_ADDRESS=0x37c026c7207de8f202a06726eb02e6233ed06160
AGENT_PAYMENT_TOKEN=0x8f4660ed18a3ba5ba9dbe64e18f06ef4a43c0136
AGENT_VAULT_CODE_HASH=0xfd17310a8244ab625fa1f2d2c00a2e01ed9dd425283e771958b0ecffb7af2e2a
AGENT_TOKEN_CODE_HASH=0x649d05402436e39e09c911b9427c7b9c97307a0c0900f8657b0e3887c8f1c280
AGENT_PRIVATE_KEY=
SIM_DATAHUB_PRIVATE_KEY=
SIM_WEATHERCO_PRIVATE_KEY=
FLINT_DEPLOYMENT_BLOCK=69948350
FLINT_WEB_ORIGIN=https://YOUR-APP.vercel.app
# Keep disabled until deployed chain/database readiness and owner setup pass.
EARMARK_ENABLE_TESTNET_EXECUTION=false
AGENT_MODEL_MODE=mock
AI_ENABLE_NETWORK=false
# Genuine Google Gemini provider (server-only). Disabled by default; the backend
# refuses Gemini inference unless EARMARK_GEMINI_ENABLED=true. Never expose the
# key through NEXT_PUBLIC_ variables, frontend bundles or logs.
EARMARK_GEMINI_ENABLED=false
# Phase C preview: retain mock for financial workflows, enable only authenticated
# read-only Gemini after approval; EARMARK_ENABLE_TESTNET_EXECUTION stays false.
AGENT_MODEL_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=10000
# Vercel SERVER-only environment: fixed Render origin, never localhost.
EARMARK_API_URL=https://YOUR-API.onrender.com
EARMARK_DEPLOYMENT=monad-testnet
# Browser-public, nonsecret configuration only:
NEXT_PUBLIC_CHAIN_ID=10143
# Do not store signer keys in Neon or expose them via NEXT_PUBLIC_.
