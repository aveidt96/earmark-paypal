# Server-only examples. Nothing loads this file automatically.
# The demo creates trusted local pins and random in-memory burner keys itself.
AGENT_MODEL_MODE=mock
AI_ENABLE_NETWORK=false
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_API_KEY=
AI_TIMEOUT_MS=15000
# Genuine Google Gemini provider (server-only). Disabled by default; the backend
# refuses Gemini inference unless EARMARK_GEMINI_ENABLED=true. Never expose the
# key through NEXT_PUBLIC_ variables, frontend bundles or logs.
EARMARK_GEMINI_ENABLED=false
# Phase C read-only sessions never use the signing runner.
EARMARK_ENABLE_TESTNET_EXECUTION=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# For a separately operated local runtime: owner supplies trusted manifest values.
# Never put these keys in frontend configuration or pass them to a model.
AGENT_CHAIN_ID=31337
AGENT_RPC_URL=http://127.0.0.1:8545
TASK_VAULT_ADDRESS=
AGENT_EXPECTED_VAULT_ADDRESS=
AGENT_PAYMENT_TOKEN=
AGENT_VAULT_CODE_HASH=
AGENT_PRIVATE_KEY=
# Pass an IntentStore path explicitly; use one journal for each signing wallet.
# Example ignored path: .agent-state/intents.json

# Future target metadata only; Stage 5 signer refuses external chains.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Live/paid model calls and Monad deployment require separate authorization.
