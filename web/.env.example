# Earmark PayPal server-only settings; see the root .env.example for all placeholders.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_BACKEND_ENABLED=false
PAYPAL_PAYMENTS_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
# New dedicated direct Neon database only; no automatic migration on startup.
PAYPAL_DATABASE_URL=
PAYPAL_DATABASE_ENVIRONMENT=sandbox
# Legacy configuration below is not a fallback for PAYPAL_DATABASE_URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
EARMARK_DATABASE_ENVIRONMENT=earmark-paypal-sandbox
EARMARK_GEMINI_ENABLED=false
AGENT_MODEL_PROVIDER=mock
EARMARK_ENABLE_TESTNET_EXECUTION=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Preserved legacy settings. Copy to web/.env.local only for a manually managed local chain.
# npm run web:local supplies these in the server process environment automatically.
# Never prefix signing keys, model secrets or provider credentials with NEXT_PUBLIC_.
AGENT_MODEL_MODE=mock
AI_ENABLE_NETWORK=false
AGENT_CHAIN_ID=31337
AGENT_RPC_URL=http://127.0.0.1:8545
TASK_VAULT_ADDRESS=
AGENT_EXPECTED_VAULT_ADDRESS=
AGENT_PAYMENT_TOKEN=
AGENT_VAULT_CODE_HASH=
AGENT_PRIVATE_KEY=
SIM_DATAHUB_PRIVATE_KEY=
SIM_WEATHERCO_PRIVATE_KEY=
# Absolute persistent directory; generated launcher state is ignored under .tools/.
FLINT_STATE_DIR=
FLINT_DEPLOYMENT_BLOCK=0
FLINT_WEB_ORIGIN=http://127.0.0.1:3000
# Optional Qwen configuration; no paid inference is authorized by this template.
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_API_KEY=
AI_TIMEOUT_MS=15000

# Optional read-only local Security Demos evidence; never accepts client-selected paths.
EARMARK_DEMO_STATE_PATH=
