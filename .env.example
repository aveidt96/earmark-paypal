# Earmark PayPal — template only. No application automatically loads this root file.
# npm run dev / npm start: copy to web/.env.local for Next.js server settings.
# No PayPal OAuth/order/authorize/capture/refund implementation exists yet.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_PAYMENTS_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Use a NEW dedicated Neon project/branch. Do not reuse the Monad database.
# These are placeholders for the upcoming PayPal schema; do not run db:migrate.
# Pooled application URL (future), direct unpooled URL for session advisory locks.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_PROJECT-pooler.REGION.aws.neon.tech/earmark_paypal?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_PROJECT.REGION.aws.neon.tech/earmark_paypal?sslmode=require
EARMARK_DATABASE_ENVIRONMENT=earmark-paypal-sandbox

# Preserved legacy EVM local-workspace configuration follows.
# Web public settings: web/.env.example -> web/.env.local (optional).
# Leave unset for local Anvil. Set 10143 only for a separately configured legacy workspace.
# NEXT_PUBLIC_CHAIN_ID=10143
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Agent server process only. See agent/.env.example and agent/README.md.
# Mock demo needs no credentials and generates separate burners in memory.
AGENT_MODEL_MODE=mock
AI_ENABLE_NETWORK=false
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_API_KEY=
AI_TIMEOUT_MS=15000
# Genuine Google Gemini provider (server-only). Disabled by default; the backend
# refuses Gemini inference unless EARMARK_GEMINI_ENABLED=true. Never expose the
# key through NEXT_PUBLIC_ variables, frontend bundles or logs.
EARMARK_GEMINI_ENABLED=false
# Phase C read-only console is independent of the financial model selection.
# Keep these defaults; encrypted local console launcher enables Gemini only in its child.
AGENT_MODEL_PROVIDER=mock
EARMARK_ENABLE_TESTNET_EXECUTION=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AGENT_CHAIN_ID=31337
AGENT_RPC_URL=http://127.0.0.1:8545
TASK_VAULT_ADDRESS=
AGENT_EXPECTED_VAULT_ADDRESS=
AGENT_PAYMENT_TOKEN=
AGENT_VAULT_CODE_HASH=
AGENT_PRIVATE_KEY=
# Never use NEXT_PUBLIC_ for secrets. No real funds or paid inference authorized.
# Stage 6 local workspace server only; launcher supplies these without a .env file.
SIM_DATAHUB_PRIVATE_KEY=
SIM_WEATHERCO_PRIVATE_KEY=
FLINT_STATE_DIR=
FLINT_DEPLOYMENT_BLOCK=0
FLINT_WEB_ORIGIN=http://127.0.0.1:3000
# FLINT_STATE_DIR must be an absolute path on trusted persistent local disk.
